# --- Сервер ---
PORT=3000
NODE_ENV=development

# --- OpenRouter (AI) ---
# Серверный ключ. НИКОГДА не коммитить реальный ключ.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# --- Postgres ---
# Основная БД
DATABASE_URL=postgres://localhost:5432/nutritiontracker
# Отдельная тестовая БД (копия) — с 1-го дня, см. ARCHITECTURE.md
TEST_DATABASE_URL=postgres://localhost:5432/nutritiontracker_test

# --- Auth ---
# dev = принимает X-Dev-Auth заголовок (аттестацию нельзя воспроизвести на симуляторе)
# prod = реальные App Attest / Play Integrity
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-local-dev-secret

# --- App Attest (iOS), prod ---
APPLE_TEAM_ID=                 # 10-символьный Team ID (Apple Developer). Обязателен для prod-attestation.
APPLE_BUNDLE_ID=com.nutrition.tracker
# Принимать development-attestation (AAGUID "appattestdevelop", сборки из Xcode).
# В prod ДОЛЖНО быть false — dev-attestation подделывается с любого dev-устройства.
APPLE_ALLOW_DEV_ATTEST=false

# --- Play Integrity (Android), prod ---
GOOGLE_PACKAGE_NAME=uk.nutritiontracker.app
GOOGLE_CLOUD_PROJECT_NUMBER=   # номер Cloud-проекта, привязанного в Play Console
# Путь к JSON сервис-аккаунта с доступом к Play Integrity API (scope playintegrity).
# Если пусто — google-auth-library берёт Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Требовать appLicensingVerdict==LICENSED (блокирует sideload/внутренних тестеров).
# false на время тестирования, true перед публичным релизом.
PLAY_INTEGRITY_REQUIRE_LICENSED=false

# --- Attestation tuning (безопасные значения по умолчанию) ---
ATTEST_CHALLENGE_TTL_SEC=300   # время жизни enrollment-challenge (одноразовый)
ATTEST_FRESHNESS_SEC=300       # допустимый перекос часов для per-request проверки свежести

# --- Аккаунты пользователей (Sign in with Apple / Google) ---
# Секрет для подписи НАШИХ access-JWT. В prod обязательно длинный случайный.
JWT_SECRET=dev-insecure-jwt-secret-change-me
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# Apple Sign In (из Apple Developer → Certificates, Identifiers & Keys)
APPLE_SERVICES_ID=            # Services ID (для web/Android flow), напр. com.nutrition.tracker.signin
APPLE_KEY_ID=                 # Key ID ключа Sign in with Apple (.p8)
APPLE_PRIVATE_KEY=            # содержимое .p8, переносы строк как \n
APPLE_REDIRECT_URI=           # redirect_uri для web-OAuth (Android), напр. https://api..../v1/auth/apple/callback

# Google Sign In (OAuth client IDs из Google Cloud Console)
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# --- Rate limit (per-device) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
